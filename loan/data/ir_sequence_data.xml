<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="ir_sequence_loan_id" model="ir.sequence">
            <field name="name">Loan Id Numbers</field>
            <field name="code">loan.sequence.data</field>
            <field name="prefix">LOAN/%(y)s/</field>
            <field name="padding">5</field>
        </record>

        <record id="seq_ref_number" model="ir.sequence">
            <field name="name">Memo Sequence</field>
            <field name="code">account.payment.ref</field>
            <field name="prefix">/INSTLMT/</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
