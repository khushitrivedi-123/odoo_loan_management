<odoo>
    <template id="loan_inquiry_template" name="Loan Inquiry Form">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2>Loan Inquiry Registration</h2>
                <form action="/loan/inquiry/submit" method="post">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <div class="form-group">
                        <label for="client_name">Client Name</label>
                        <input type="text" name="client_name" required="1" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label for="email">Email</label>
                        <input type="email" name="email" required="1" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label for="phone_number">Phone Number</label>
                        <input type="text" name="phone_number" required="1" class="form-control"/>
                    </div>
                    <div class="form-group">
                        <label for="gender">Gender</label>
                        <select name="gender" class="form-control">
                            <option value="male">Male</option>
                            <option value="female">Female</option>
                            <option value="other">Other</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label for="city">City</label>
                        <select name="city" class="form-control">
                            <option value="ahmedabad">Ahmedabad</option>
                            <option value="mumbai">Mumbai</option>
                            <option value="delhi">Delhi</option>
                        </select>
                    </div>
                    <button type="submit" class="btn btn-primary mt-3">Submit Inquiry</button>
                </form>
            </div>
        </t>
    </template>

    <template id="inquiry_success" name="Loan Inquiry Success">
        <t t-call="website.layout">
            <div class="container mt-5">
                <h2>Thank You!</h2>
                <p>Your loan inquiry has been submitted successfully. We will contact you soon.</p>
                <a href="/" class="btn btn-primary">Go to Home</a>
            </div>
        </t>
    </template>

    <record id="menu_loan_inquiry_submit" model="website.menu">
        <field name="name">Loan Inquiry</field>
        <field name="url">/loan/inquiry</field>
        <field name="parent_id" ref="website.main_menu"/>
    </record>
</odoo>
